# Copy to backend/.env and fill in your own keys. The AI judge
# (pipeline/ai_judge.py) prefers Qwen/Groq if QWEN_API_KEY is set, else the
# native Anthropic API if ANTHROPIC_API_KEY is set, else it stays off and the
# pipeline runs on the heuristic alone.

# Qwen via Groq (OpenAI-compatible endpoint)
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_API_KEY=
QWEN_MODEL=qwen/qwen3.8-27b

# Native Anthropic API (alternative)
ANTHROPIC_API_KEY=
KUKU_JUDGE_MODEL=claude-haiku-4-5-20251001
